@Metadata.layer: #PARTNER
@UI: {
  headerInfo: { typeName: 'BOQ Sales Report',
                typeNamePlural: 'BOQ Sales Report',
                title: { type: #STANDARD, label: 'BOQ Sales Report', value: 'SalesOrderNumber' } },
  presentationVariant: [{ sortOrder: [{ by: 'SalesOrderNumber', direction:  #ASC }] }] }



//@Metadata.layer: #PARTNER
//@UI.headerInfo: { typeName: 'BOQ Sales Report', typeNamePlural:'BOQ Sales Report' }
annotate entity ZSD_BOQ_REPORT with                                                                                         //Metadata of BOQ Sales Report
{
@UI: { lineItem: [ { position: 10, importance: #HIGH } ] }
